FROM golang:1.21-alpine AS builder

WORKDIR /app

# Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build the application
RUN go build -o /backend-app app/main.go

# Run stage
FROM alpine:latest

WORKDIR /app

# Install tzdata if needed for timezone
RUN apk add --no-cache tzdata

COPY --from=builder /backend-app /app/backend-app
COPY config.yaml /app/config.yaml

EXPOSE 5000

CMD ["/app/backend-app", "-c", "config.yaml"]
