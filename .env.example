# =============================================================
#  .env.example — Backend Service
#  Copy this to .env on the VPS and fill in real values.
#  DO NOT commit .env to version control.
# =============================================================

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_NAME=ATTENDANCE_DB
DATABASE_USER=admin
DATABASE_PASSWORD=your_strong_db_password_here
# DATABASE_HOST and DATABASE_PORT are set via service name in config.yaml

# ── MinIO (Object Storage) ───────────────────────────────────
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=attendance
# MINIO_HOST and MINIO_PORT are set via service name in config.yaml

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=your_strong_redis_password_here
# REDIS_HOST and REDIS_PORT are set via service name in config.yaml

# ── Jira ─────────────────────────────────────────────────────
JIRA_URL=https://farchanputra1358.atlassian.net/
JIRA_EMAIL=farchanputra1358@gmail.com
JIRA_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=SCRUM
